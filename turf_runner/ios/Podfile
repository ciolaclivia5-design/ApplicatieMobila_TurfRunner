# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'turf_runner' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # 1. THE DEFINITIVE FMT FIX: Patch base.h directly
    fmt_base = File.join(installer.sandbox.pod_dir('fmt'), 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      File.chmod(0644, fmt_base) # Ensure the file is writable
      content = File.read(fmt_base)
      # Replace all instances of FMT_USE_CONSTEVAL 1 with 0
      content = content.gsub(/#\s*define\s+FMT_USE_CONSTEVAL\s+1/, '#define FMT_USE_CONSTEVAL 0')
      # Broaden the Apple Clang check to catch newer Xcode versions
      content = content.gsub('__apple_build_version__ < 14000029L', '__apple_build_version__')
      File.write(fmt_base, content)
    end

    installer.pods_project.targets.each do |target|
      # 2. Suppress Yoga warnings
      target.build_configurations.each do |build_config|
        cflags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        cflags = [cflags] unless cflags.is_a?(Array)
        unless cflags.include?('-Wno-deprecated-literal-operator')
          cflags << '-Wno-deprecated-literal-operator'
        end
        build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cflags
      end

      # 3. Fix hermes-engine missing REACT_NATIVE_PATH
      if target.name == 'hermes-engine'
        target.build_phases.each do |phase|
          if phase.class.name == 'Xcodeproj::Project::Object::PBXShellScriptBuildPhase'
            forced_path = "export REACT_NATIVE_PATH=\"${PODS_ROOT}/../../node_modules/react-native\"\n"
            unless phase.shell_script.start_with?(forced_path)
              phase.shell_script = forced_path + phase.shell_script
            end
          end
        end
      end
    end
  end
end